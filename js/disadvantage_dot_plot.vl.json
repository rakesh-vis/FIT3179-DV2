{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 520,
  "height": {
    "step": 70
  },
  "title": {
    "text": "Severe food insecurity is five times more common in the most disadvantaged areas",
    "subtitle": "% of households at each level of food insecurity, most vs least disadvantaged 20% of areas, 2023",
    "anchor": "start"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/rakesh-vis/FIT3179-DV2/refs/heads/main/data/abs_food_security.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "indexof(datum.characteristic, 'Index of Relative Socio-Economic Disadvantage') === 0 && indexof(['Lowest quintile', 'Highest quintile'], datum.group_label) >= 0 && indexof(['marginal', 'moderate', 'severe'], datum.status) >= 0"
    },
    {
      "calculate": "datum.group_label === 'Lowest quintile' ? 'Most disadvantaged areas' : 'Least disadvantaged areas'",
      "as": "area_group"
    },
    {
      "calculate": "{'marginal': 'Marginal', 'moderate': 'Moderate', 'severe': 'Severe'}[datum.status]",
      "as": "level"
    }
  ],
  "encoding": {
    "y": {
      "field": "level",
      "type": "ordinal",
      "sort": [
        "Marginal",
        "Moderate",
        "Severe"
      ],
      "title": null,
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 13,
        "labelFontWeight": "bold",
        "labelPadding": 10
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#c9ced6",
        "strokeWidth": 4
      },
      "encoding": {
        "x": {
          "aggregate": "min",
          "field": "percentage",
          "type": "quantitative",
          "title": "Households (%)",
          "scale": {
            "domain": [
              0,
              10
            ]
          },
          "axis": {
            "grid": true,
            "gridColor": "#eceef1",
            "domain": false,
            "values": [
              0,
              2,
              4,
              6,
              8,
              10
            ],
            "labelFontSize": 12,
            "titleFontSize": 12,
            "titlePadding": 10,
            "format": ".0f"
          }
        },
        "x2": {
          "aggregate": "max",
          "field": "percentage"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 260,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "percentage",
          "type": "quantitative"
        },
        "color": {
          "field": "area_group",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Most disadvantaged areas",
              "Least disadvantaged areas"
            ],
            "range": [
              "#e76f51",
              "#8a94a3"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolSize": 180,
            "labelFontSize": 12,
            "labelLimit": 300
          }
        },
        "tooltip": [
          {
            "field": "area_group",
            "type": "nominal",
            "title": "Areas"
          },
          {
            "field": "level",
            "type": "ordinal",
            "title": "Level"
          },
          {
            "field": "percentage",
            "type": "quantitative",
            "title": "Households (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -18,
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "percentage",
          "type": "quantitative"
        },
        "text": {
          "field": "percentage",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "field": "area_group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Most disadvantaged areas",
              "Least disadvantaged areas"
            ],
            "range": [
              "#c4532f",
              "#6b7380"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 16,
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#4a5563"
      },
      "encoding": {
        "x": {
          "datum": 7.8,
          "type": "quantitative"
        },
        "y": {
          "datum": "Severe"
        },
        "text": {
          "value": "5 times higher"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "title": {
      "offset": 20,
      "subtitlePadding": 6,
      "fontSize": 16,
      "subtitleFontSize": 13,
      "subtitleColor": "#4a5563"
    },
    "legend": {
      "labelFontSize": 12
    }
  }
}
