
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 520,
  "height": 280,
  "title": {
    "text": "Food insecurity is six times higher in the lowest-income households",
    "subtitle": "% of households experiencing food insecurity, by household income group (fifths), 2023",
    "anchor": "start"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/rakesh-vis/FIT3179-DV2/refs/heads/main/data/abs_food_security.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "filter": "datum.characteristic === 'Equivalised gross weekly household income quintiles(h)' && datum.status === 'total_food_insecure'"
    },
    {
      "calculate": "toNumber(datum.percentage)",
      "as": "percentage"
    },
    {
      "calculate": "{'Lowest quintile': 'Lowest 20%', '2nd quintile': '2nd 20%', '3rd quintile': 'Middle 20%', '4th quintile': '4th 20%', 'Highest quintile': 'Highest 20%'}[datum.group_label]",
      "as": "income_group"
    }
  ],
  "encoding": {
    "x": {
      "field": "income_group",
      "type": "ordinal",
      "sort": [
        "Lowest 20%",
        "2nd 20%",
        "Middle 20%",
        "4th 20%",
        "Highest 20%"
      ],
      "title": "Household income group",
      "axis": {
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "labelPadding": 8,
        "titlePadding": 12
      }
    },
    "y": {
      "field": "percentage",
      "type": "quantitative",
      "title": "% of households",
      "scale": {
        "domain": [
          0,
          25
        ]
      },
      "axis": {
        "grid": true,
        "gridColor": "#eceef1",
        "domain": false,
        "values": [
          0,
          5,
          10,
          15,
          20,
          25
        ]
      }
    },
    "tooltip": [
      {
        "field": "income_group",
        "type": "nominal",
        "title": "Income group"
      },
      {
        "field": "percentage",
        "type": "quantitative",
        "title": "% food insecure",
        "format": ".1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "datum": 0
        },
        "y2": {
          "field": "percentage"
        },
        "color": {
          "condition": {
            "test": "datum.group_label === 'Lowest quintile'",
            "value": "#e76f51"
          },
          "value": "#6baed6"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 220,
        "opacity": 1
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.group_label === 'Lowest quintile'",
            "value": "#e76f51"
          },
          "value": "#3182bd"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -18,
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "text": {
          "field": "percentage",
          "type": "quantitative",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.group_label === 'Lowest quintile'",
            "value": "#c4532f"
          },
          "value": "#1f5f8f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.group_label === 'Lowest quintile'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 16,
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#4a5563",
        "lineBreak": "\n"
      },
      "encoding": {
        "text": {
          "value": "6 times the rate of the\nhighest-income households (3.6%)"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "title": {
      "offset": 20,
      "subtitlePadding": 6,
      "fontSize": 16,
      "subtitleFontSize": 13,
      "subtitleColor": "#4a5563"
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#4a5563",
      "titleColor": "#4a5563"
    }
  }
}
