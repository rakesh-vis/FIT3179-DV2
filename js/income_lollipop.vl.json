{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 600,
  "height": 280,
  "title": {
    "text": "Food insecurity across household income groups",
    "subtitle": "Australian households, 2023",
    "anchor": "start"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/rakesh-vis/FIT3179-DV2/refs/heads/main/data/abs_food_security.csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "filter": "datum.characteristic === 'Equivalised gross weekly household income quintiles(h)' && datum.status === 'total_food_insecure'"
    }
  ],
  "encoding": {
    "x": {
      "field": "group_label",
      "type": "ordinal",
      "sort": [
        "Lowest quintile",
        "2nd quintile",
        "3rd quintile",
        "4th quintile",
        "Highest quintile"
      ],
      "title": "Household income quintile (%)",
      "axis": {"labelAngle": 0}
    },
    "y": {
      "field": "percentage",
      "type": "quantitative",
      "title": "Households experiencing food insecurity (%)",
      "scale": {"zero": true}
    },
    "tooltip": [
      {"field": "group_label", "type": "nominal", "title": "Income group"},
      {
        "field": "percentage",
        "type": "quantitative",
        "title": "Food insecurity rate (%)",
        "format": ".1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 3, "color": "#4E79A7"},
      "encoding": {"y": {"datum": 0}, "y2": {"field": "percentage"}}
    },
    {"mark": {"type": "point", "filled": true, "size": 150, "color": "#4E79A7"}}
  ],
  "config": {}
}