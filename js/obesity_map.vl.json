          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "label_lon"
        },
        "latitude2": {
          "field": "label_lat"
        }
