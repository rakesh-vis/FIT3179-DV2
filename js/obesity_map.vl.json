{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 700,
  "height": 560,
  "title": {
    "text": "Obesity is most common across regional eastern Australia and Tasmania",
    "subtitle": "% of adults with obesity by Local Government Area (LGA), 2022 · Grey = no estimate available",
    "anchor": "start"
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "params": [
    {
      "name": "min_rate",
      "value": 15,
      "bind": {
        "input": "range",
        "min": 15,
        "max": 50,
        "step": 1,
        "name": "Highlight areas with an obesity rate of at least (%): "
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "title": {
      "offset": 20,
      "subtitlePadding": 6,
      "fontSize": 16,
      "subtitleFontSize": 13,
      "subtitleColor": "#4a5563"
    }
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rakesh-vis/FIT3179-DV2/refs/heads/main/data/lga_2021.topojson",
        "format": {
          "type": "topojson",
          "feature": "lga_2021"
        }
      },
      "transform": [
        {
          "lookup": "properties.lga_code",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/rakesh-vis/FIT3179-DV2/refs/heads/main/data/lga_obesity.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "lga_code": "string"
                }
              }
            },
            "key": "lga_code",
            "fields": [
              "obesity_rate",
              "status"
            ]
          }
        },
        {
          "calculate": "toNumber(datum.obesity_rate)",
          "as": "obesity_rate"
        }
      ],
      "mark": {
        "type": "geoshape",
        "invalid": null,
        "stroke": "white",
        "strokeWidth": 0.3
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "!isValid(datum.obesity_rate)",
            "value": "#d9d9d9"
          },
          "field": "obesity_rate",
          "type": "quantitative",
          "title": "Adults with obesity (%)",
          "scale": {
            "type": "threshold",
            "domain": [
              25,
              30,
              35,
              40
            ],
            "range": [
              "#eff3ff",
              "#bdd7e7",
              "#6baed6",
              "#3182bd",
              "#08519c"
            ]
          },
          "legend": {
            "type": "symbol",
            "orient": "bottom-left",
            "symbolType": "square",
            "symbolSize": 200,
            "titleLimit": 250
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "LGA"
          },
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "obesity_rate",
            "type": "quantitative",
            "title": "Adults with obesity (%)",
            "format": ".1f"
          },
          {
            "field": "status",
            "type": "nominal",
            "title": "Estimate status"
          }
        ],
        "opacity": {
          "condition": {
            "test": "isValid(datum.obesity_rate) && datum.obesity_rate < min_rate",
            "value": 0.15
          },
          "value": 1
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 145.75,
            "lat": -42.2,
            "label_lon": 141,
            "label_lat": -41.3,
            "align": "right",
            "label": "Highest: West Coast (Tas.)\n49.5% of adults"
          },
          {
            "lon": 132.25,
            "lat": -14.75,
            "label_lon": 125.5,
            "label_lat": -13,
            "align": "right",
            "label": "Katherine (NT)\n48.9%"
          },
          {
            "lon": 138.6,
            "lat": -34.92,
            "label_lon": 133,
            "label_lat": -37.6,
            "align": "right",
            "label": "Lowest: City of Adelaide\n15.8%"
          },
